#!/usr/bin/env bash
# ingest-config — resolve this skill's configuration without hardcoding it in SKILL.md.
#
# The protocol (one commit, explicit paths, validator, log line) fits any vault; the names
# do not. They live outside this repository, in two places, and this is the only thing that
# reads them:
#
#   1. the machine file, which locates the vault:
#        $INGEST_CONFIG
#        $XDG_CONFIG_HOME/vault-ingest/config.toml
#        ~/.config/vault-ingest/config.toml      (macOS, Linux)
#        %APPDATA%\vault-ingest\config.toml      (Windows)
#   2. the vault file, `<vault_root>/.ingest.md`, which overrides everything else.
#      It lives in the vault because it describes that vault, so it stays private.
#
# Usage:
#   ingest-config              print every resolved key as KEY=value
#   ingest-config <key>        print one value (exit 1 when empty)
#   ingest-config --file       print the config files that were read
#   ingest-config --check      verify vault_root exists (warns if log_dir does not)
#
# Keys: vault_root vault_marker log_dir log_file validator commit_prefix log_lang
# Accepted per line: `key = "value"`, `key = value`, `key: value`. # starts a comment.
# [section] headers are ignored: the keys count anyway.
#
# Env: INGEST_CONFIG — machine file path (used by the tests too).
set -uo pipefail

KEYS="vault_root vault_marker log_dir log_file validator commit_prefix log_lang"

defaults() {
  case "$1" in
    vault_marker) printf 'AGENTS.md' ;;
    log_dir) printf 'log' ;;
    log_file) printf '' ;;
    validator) printf 'none' ;;
    commit_prefix) printf '[pi]' ;;
    log_lang) printf '' ;;
    *) printf '' ;;
  esac
}

machine_file=""
for c in "${INGEST_CONFIG:-}" \
         "${XDG_CONFIG_HOME:+$XDG_CONFIG_HOME/vault-ingest/config.toml}" \
         "${HOME:+$HOME/.config/vault-ingest/config.toml}" \
         "${APPDATA:+$APPDATA/vault-ingest/config.toml}"; do
  [ -n "$c" ] || continue
  machine_file="$c"
  [ -f "$c" ] && break
done

# Legge una chiave da un file: prima `k = v` (TOML-lite), poi `k: v`.
# Le virgolette attorno al valore si tolgono; il resto resta com'e'.
read_key() {
  local file="$1" key="$2" raw
  [ -f "$file" ] || return 1
  raw="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$file" | head -1)"
  if [ -z "$raw" ]; then
    raw="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*:[[:space:]]*//p" "$file" | head -1)"
  fi
  [ -n "$raw" ] || return 1
  raw="${raw%%#*}"
  raw="$(printf '%s' "$raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//')"
  [ -n "$raw" ] || return 1
  printf '%s' "$raw"
}

value_of() {
  local key="$1" v vault vault_file
  case "$key" in
    vault_root)
      v="$(read_key "$machine_file" vault_root)" || v=""
      ;;
    *)
      v="$(read_key "$machine_file" "$key")" || v=""
      vault="$(value_of vault_root)"
      vault_file="$vault/.ingest.md"
      if [ -n "$vault" ] && [ -f "$vault_file" ]; then
        local over
        over="$(read_key "$vault_file" "$key")" && v="$over"
      fi
      ;;
  esac
  [ -n "$v" ] || v="$(defaults "$key")"
  printf '%s' "$v"
}

case "${1:-}" in
  --file)
    printf '%s\n' "${machine_file:-no machine file}"
    vault="$(value_of vault_root)"
    [ -n "$vault" ] && printf '%s\n' "$vault/.ingest.md"
    exit 0
    ;;
  --check)
    vault="$(value_of vault_root)"
    marker="$(value_of vault_marker)"
    if [ -z "$vault" ]; then
      printf 'vault_root is not configured: write %s\n' "${machine_file:-~/.config/vault-ingest/config.toml}" >&2
      exit 1
    fi
    [ -d "$vault" ] || { printf 'vault_root does not exist: %s\n' "$vault" >&2; exit 1; }
    if [ "$marker" = "AGENTS.md" ] && [ ! -f "$vault/$marker" ]; then
      printf 'warning: %s has no %s (default marker)\n' "$vault" "$marker" >&2
    fi
    logd="$(value_of log_dir)"
    if [ -n "$logd" ] && [ ! -d "$vault/$logd" ]; then
      printf 'warning: log_dir does not exist yet: %s/%s (the ingest creates it)\n' "$vault" "$logd" >&2
    fi
    printf 'config ok: vault=%s log=%s validator=%s\n' "$vault" "$logd" "$(value_of validator)"
    exit 0
    ;;
  '' )
    for k in $KEYS; do printf '%s=%s\n' "$k" "$(value_of "$k")"; done
    exit 0
    ;;
  -*)
    printf 'opzione non riconosciuta: %s\n' "$1" >&2; exit 2
    ;;
  *)
    out="$(value_of "$1")"
    [ -n "$out" ] || { printf 'empty or unknown key: %s\n' "$1" >&2; exit 1; }
    printf '%s\n' "$out"
    ;;
esac
